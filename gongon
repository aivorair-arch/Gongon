#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════╗
# ║          AIVORA AI - Complete Auto-Installer v2.0            ║
# ║     One-Click Installation - Production Ready Platform        ║
# ╚═══════════════════════════════════════════════════════════════╝

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Functions
print_banner() {
    clear
    echo -e "${CYAN}"
    cat << "EOF"
╔═══════════════════════════════════════════════════════════════╗
║                                                               ║
║          █████╗ ██╗   ██╗████████╗██╗  ██╗███████╗          ║
║         ██╔══██╗██║   ██║╚══██╔══╝██║  ██║██╔════╝          ║
║         ███████║██║   ██║   ██║   ███████║█████╗            ║
║         ██══██║██║   ██║   ██║   ██╔══██║██╔══╝            ║
║         ██║  ██║╚██████╝   ██║   ██║  ██║███████╗          ║
║         ╚═╝  ╚═╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝══════╝          ║
║                                                               
║                  AI Platform - Auto Installer                 ║
║                     Version 2.0 - 2026                        ║
║                                                               ║
╚═══════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}\n"
}

log_info() { echo -e "${BLUE}[✓]${NC} $1"; }
log_success() { echo -e "${GREEN}[✔]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }

# Check root
if [ "$EUID" -ne 0 ]; then 
    log_error "Please run as root: sudo bash $0"
    exit 1
fi

print_banner

# Configuration
INSTALL_DIR="/opt/aivora-ai"
DOMAIN=""
EMAIL=""
INSTALL_MODE="full"  # full, minimal, local-ai

# Interactive setup
echo -e "${CYAN}═══ Installation Configuration ═══${NC}\n"
read -p "Domain (e.g., ai.yoursite.com): " DOMAIN
read -p "Email for SSL: " EMAIL
echo ""
echo "Installation Mode:"
echo "  1) Full (Web + API + Database + Local AI)"
echo "  2) Minimal (Web + API + Database only)"
echo "  3) Local AI Only (Ollama + Models)"
read -p "Choose [1-3]: " MODE_CHOICE

case $MODE_CHOICE in
    2) INSTALL_MODE="minimal" ;;
    3) INSTALL_MODE="local-ai" ;;
    *) INSTALL_MODE="full" ;;
esac

echo ""
log_info "Configuration:"
echo "   Domain: $DOMAIN"
echo "   Email: $EMAIL"
echo "   Mode: $INSTALL_MODE"
echo ""
read -p "Continue? [y/N]: " CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    log_error "Installation cancelled"
    exit 1
fi

# Create installation directory
mkdir -p $INSTALL_DIR
cd $INSTALL_DIR

# Step 1: System Update
log_info "Updating system packages..."
apt-get update -qq
apt-get upgrade -y -qq

# Step 2: Install Docker
log_info "Installing Docker..."
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o get-docker.sh
    bash get-docker.sh
    rm get-docker.sh
    systemctl enable docker
    systemctl start docker
    log_success "Docker installed"
else
    log_info "Docker already installed"
fi

# Install Docker Compose
log_info "Installing Docker Compose..."
if [ ! -f /usr/bin/docker-compose ]; then
    curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
        -o /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose
    ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose
    log_success "Docker Compose installed"
fi

# Step 3: Create Docker Compose File
log_info "Creating Docker Compose configuration..."
cat > docker-compose.yml << 'DOCKEREOF'
version: '3.8'

services:
  # PostgreSQL Database with pgvector
  postgres:
    image: pgvector/pgvector:pg16
    container_name: aivora-postgres
    restart: always
    environment:
      POSTGRES_USER: aivora
      POSTGRES_PASSWORD: ${DB_PASSWORD:-aivora_secure_pass_2026}
      POSTGRES_DB: aivora_db
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-db.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - aivora-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U aivora"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis Cache
  redis:
    image: redis:7-alpine
    container_name: aivora-redis
    restart: always
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    networks:
      - aivora-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # MinIO Object Storage
  minio:
    image: minio/minio:latest
    container_name: aivora-minio
    restart: always
    environment:
      MINIO_ROOT_USER: ${MINIO_ACCESS_KEY:-aivora_admin}
      MINIO_ROOT_PASSWORD: ${MINIO_SECRET_KEY:-aivora_secret_2026}
    command: server /data --console-address ":9001"
    volumes:
      - minio_data:/data
    networks:
      - aivora-network
    ports:
      - "9000:9000"
      - "9001:9001"

  # Backend API
  api:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: aivora-api
    restart: always
    environment:
      NODE_ENV: production
      DATABASE_URL: postgresql://aivora:${DB_PASSWORD:-aivora_secure_pass_2026}@postgres:5432/aivora_db
      REDIS_URL: redis://redis:6379
      JWT_SECRET: ${JWT_SECRET}
      SESSION_SECRET: ${SESSION_SECRET}
      MINIO_ENDPOINT: minio
      MINIO_PORT: 9000
      MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY:-aivora_admin}
      MINIO_SECRET_KEY: ${MINIO_SECRET_KEY:-aivora_secret_2026}
      OLLAMA_HOST: http://ollama:11434
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_started
    networks:
      - aivora-network
    volumes:
      - ./backend:/app
      - /app/node_modules

  # Frontend (Next.js)
  web:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: aivora-web
    restart: always
    environment:
      NEXT_PUBLIC_API_URL: https://api.${DOMAIN}
      NODE_ENV: production
    depends_on:
      - api
    networks:
      - aivora-network
    volumes:
      - ./frontend:/app
      - /app/.next
      - /app/node_modules

  # Ollama (Local AI Models)
  ollama:
    image: ollama/ollama:latest
    container_name: aivora-ollama
    restart: always
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - aivora-network
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    # Remove deploy section if no GPU available

  # Nginx Reverse Proxy
  nginx:
    image: nginx:alpine
    container_name: aivora-nginx
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./ssl:/etc/nginx/ssl:ro
      - ./certs:/etc/letsencrypt:ro
    depends_on:
      - web
      - api
    networks:
      - aivora-network

volumes:
  postgres_data:
  redis_data:
  minio_data:
  ollama_data:

networks:
  aivora-network:
    driver: bridge
DOCKEREOF

